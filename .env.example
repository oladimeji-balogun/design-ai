# copy this file to .env and fill in real values. never commit .env

# penpot personal access token
# generated in penpot under: your account -> integrations -> personal access tokens
PENPOT_ACCESS_TOKEN=

# base url of the self-hosted penpot instance (the team's normal login url)
PENPOT_BASE_URL=

# local penpot mcp bridge — defaults from `npm run bootstrap`
# mcp server (modern streamable http endpoint)
PENPOT_MCP_URL=http://localhost:4401/mcp
# plugin server (serves manifest.json loaded into penpot)
PENPOT_PLUGIN_URL=http://localhost:4400
# websocket bridge between plugin and mcp server
PENPOT_WS_URL=ws://localhost:4402
