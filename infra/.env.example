# copy to infra/.env on the vps and fill in real values. never commit infra/.env
# .env is gitignored at the repo root.

# --- penpot core ---

# long random secret used by penpot to sign sessions. generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# public uri the browser uses to reach penpot. for the tailscale pilot this is the
# tailnet hostname, e.g. http://your-vps.tailnet-name.ts.net:9001
PENPOT_PUBLIC_URI=

# penpot feature flags. keep registration disabled on a team instance; enable login.
# adjust to taste, see penpot docs for the full flag list.
PENPOT_FLAGS=enable-login-with-password disable-registration

# --- penpot database ---
PENPOT_DATABASE_USERNAME=penpot
# use a strong generated password, not a memorable one.
PENPOT_DATABASE_PASSWORD=

# --- penpot mcp bridge ---

# image tag for the mcp server. MUST match your penpot version, and penpot must be
# >= 2.13.1 (first release with mcp). e.g. 2.13.3. do not use "latest" in prod, the
# plugin warns on a version mismatch between mcp and penpot.
PENPOT_MCP_IMAGE_TAG=

# hostname the ai client (claude code / cursor) uses to reach the mcp server.
# for the tailscale pilot this is the vps tailnet hostname, no port here.
# e.g. your-vps.tailnet-name.ts.net
PENPOT_MCP_SERVER_ADDRESS=
