# LOCAL-RUN env template. for running the stack on your own mac before the vps
# exists. copy to infra/.env and fill the two secrets:
#   cp .env.local.example .env
#
# .env is gitignored and must never be committed. this file (.env.local.example)
# holds NO real secrets, only local-safe defaults, so it is safe to commit.
#
# difference from .env.example: the URIs point at localhost instead of a tailnet
# hostname. everything else is identical, same PENPOT_VERSION, same var names,
# so a local run exercises the real deploy config.

# --- penpot core ---

# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# for a local run, penpot is reached in the browser at localhost:9001.
PENPOT_PUBLIC_URI=http://localhost:9001

# penpot release tag; drives the 3 penpotapp images + the mcp build arg. keep in
# lockstep. must be a real tag (e.g. 2.14.1), not an "mcp-prod-*" branch.
PENPOT_VERSION=2.14.1

# keep registration ENABLED locally so you can create the first account without
# the cli. (on the vps, disable-registration is the safer default.)
# disable-email-verification: this local stack has no smtp, so verification emails
# can't be sent. disabling it activates accounts immediately. do NOT carry this
# flag to a real/shared instance -- configure smtp there instead.
PENPOT_FLAGS=enable-login-with-password enable-registration disable-email-verification

# --- penpot database ---
PENPOT_DATABASE_USERNAME=penpot
# any non-empty value is fine for a local throwaway db. still don't reuse a real one.
PENPOT_DATABASE_PASSWORD=penpot-local-dev

# --- penpot mcp bridge ---

# local ai clients reach the mcp server at localhost.
PENPOT_MCP_SERVER_ADDRESS=localhost
